#################################################################
# CORE BRIDGE CONFIGURATION
#################################################################

# Set the operational mode for the bridge's output destination.
# Options: 'mock' (for local file output) or 'azure' (for real Event Hubs)
OUTPUT_TYPE=mock

#################################################################
# REDIS CONFIGURATION
#################################################################

# Hostname or IP address of your Redis instance
REDIS_HOST=127.0.0.1

# Port of your Redis instance
REDIS_PORT=6379

# The specific channel the bridge should subscribe to
REDIS_CHANNEL=data-stream-channel

# If Redis requires a password (uncomment and set if needed)
# REDIS_PASSWORD=

#################################################################
# MOCK OUTPUT CONFIGURATION (Used when OUTPUT_TYPE=mock)
#################################################################

# Local file path where the simulated Event Hub output will be written.
# Using .jsonl (JSON Lines) format is recommended.
MOCK_OUTPUT_FILE=./output_events.jsonl


#################################################################
# AZURE EVENT HUBS CONFIGURATION (Only used if OUTPUT_TYPE=azure)
#################################################################

# Full Connection String for the Event Hubs Namespace (requires 'Send' rights)
# EVENT_HUB_CONNECTION_STRING="Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=..."

# The specific name of the Event Hub instance within the namespace
# EVENT_HUB_NAME="your-event-hub-name"
